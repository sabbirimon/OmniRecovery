{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniRecovery",
  "version": "0.3.9",
  "identifier": "local.omnirecovery.desktop",
  "build": { "frontendDist": "frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "OmniRecovery", "width": 1180, "height": 810, "minWidth": 790, "minHeight": 620, "center": true }
    ],
    "security": {
      "capabilities": [{ "identifier": "desktop-file-drop", "windows": ["main"], "permissions": ["core:event:allow-listen"] }],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
